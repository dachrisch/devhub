# --- opencode (code.lehel.xyz) ---
# code.lehel.xyz fronts opencode with Basic auth (user "opencode", password = server password).
OPENCODE_BASIC_USER=opencode
OPENCODE_BASIC_PASSWORD=your-opencode-server-password
# X-Api-Key is only needed for local opencode servers that don't use Basic auth.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://code.lehel.xyz

# --- GitHub (dachrisch personal + bumbleflies org) ---
GH_TOKEN=your-dachrisch-pat
BUMBLEFLIES_GH_TOKEN=your-bumbleflies-org-pat
GITHUB_TOPICS=gh-dash,dachrisch,bumbleflies

# --- workspace where repos are provisioned/checked out ---
WORKSPACE_ROOT=/home/cda/dev
# workspace root as seen by the opencode agent inside the container
OPENCODE_WORKSPACE_ROOT=/root/dev

# --- optional ---
# DEVHUB_DB=./devhub.db
# OPENCODE_ALLOW_INSECURE_TLS=false
